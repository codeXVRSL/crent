            "index": 0
          }
        ]
      ]
    },
    "Anyone New?": {
      "main": [
        [
          {
            "node": "Send Welcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Welcome": {
      "main": [
        [
          {
            "node": "Mark Welcomed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tell Admin: Send Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Manila",
    "errorWorkflow": "ODAdminErrors001"
  },
  "pinData": {}
}