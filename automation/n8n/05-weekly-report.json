{
  "id": "ODAdminWeekly001",
  "name": "Outlier Desk Admin · Weekly Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "ea539eff-9bb2-4d81-866f-ad9a199c9eaa",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0c07a47d-70c4-4e61-b241-a493f8854cb5",
              "name": "app_url",
              "value": "https://YOUR-APP.vercel.app",
              "type": "string"
            },
            {
              "id": "dd26cee6-c3f9-44cb-a6b2-367b6104003e",
              "name": "admin_email",
              "value": "PASTE_YOUR_EMAIL",
              "type": "string"
            },
            {
              "id": "f658c07f-a17c-4880-acd0-3bde2c954559",
              "name": "sheet_id",
              "value": "PASTE_GOOGLE_SHEET_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "41d62c3a-9c08-4e03-8402-24a6cdda4da6",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "All settings in one place: your live site URL and the email that receives admin mail."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with r as (select now() - interval '7 days' as since)\nselect to_char((now() at time zone 'Asia/Manila')::date - 7, 'YYYY-MM-DD') as week_start,\n  (select count(*) from profiles, r where created_at > r.since and role = 'creator')::int        as new_creators,\n  (select count(*) from profiles, r where created_at > r.since and role = 'cre')::int            as new_researchers,\n  (select count(*) from cre_profiles, r where kyc_status = 'approved' and kyc_reviewed_at > r.since)::int as researchers_verified,\n  (select count(*) from briefs, r where opened_at > r.since)::int                                as briefs_live,\n  (select count(*) from briefs, r where opened_at > r.since and invited_cre_id is not null)::int as private_briefs,\n  (select count(*) from pitches, r where submitted_at > r.since)::int                            as pitches,\n  (select count(*) from unlocks, r where created_at > r.since)::int                              as unlocks,\n  (select round(100.0 * count(*) filter (where status = 'unlocked') / nullif(count(*) filter (where status <> 'withdrawn'), 0))\n     from pitches, r where submitted_at > r.since)::int                                          as unlock_rate_pct,\n  (select coalesce(sum(budget_cents), 0) from briefs, r where opened_at > r.since)::bigint       as gmv_cents,\n  (select coalesce(sum(case when credit_account = 'platform:revenue' then amount_cents\n                            when debit_account = 'platform:revenue' then -amount_cents end), 0)\n     from ledger_entries, r where created_at > r.since)::bigint                                  as revenue_cents,\n  (select coalesce(sum(amount_cents), 0) from payouts, r where paid_at > r.since)::bigint        as paid_out_cents,\n  (select count(*) from disputes, r where opened_at > r.since)::int                              as disputes,\n  (select count(*) from flags, r where created_at > r.since)::int                                as flags",
        "options": {}
      },
      "id": "51867e96-0432-4266-b99c-f23135eb9ce6",
      "name": "Read Week",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Outlier Desk DB (n8n_admin)"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.sheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Weekly"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Week starting": "={{ $json.week_start ?? 0 }}",
            "New creators": "={{ $json.new_creators ?? 0 }}",
            "New researchers": "={{ $json.new_researchers ?? 0 }}",
            "Researchers verified": "={{ $json.researchers_verified ?? 0 }}",
            "Briefs live": "={{ $json.briefs_live ?? 0 }}",
            "Private briefs": "={{ $json.private_briefs ?? 0 }}",
            "Pitches": "={{ $json.pitches ?? 0 }}",
            "Unlocks": "={{ $json.unlocks ?? 0 }}",
            "Unlock rate %": "={{ $json.unlock_rate_pct ?? 0 }}",
            "GMV ($)": "={{ (Number($json.gmv_cents || 0) / 100).toFixed(2) }}",
            "Revenue ($)": "={{ (Number($json.revenue_cents || 0) / 100).toFixed(2) }}",
            "Paid out ($)": "={{ (Number($json.paid_out_cents || 0) / 100).toFixed(2) }}",
            "Disputes": "={{ $json.disputes ?? 0 }}",
            "Flags": "={{ $json.flags ?? 0 }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "Week starting",
              "displayName": "Week starting",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
