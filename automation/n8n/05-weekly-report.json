      "id": "68d0e733-a281-4d28-b321-2a269e4d19b3",
      "name": "Add to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        -100
      ],
      "notes": "Tab 'Weekly' with these headers in row 1. One row per week, so you can chart growth.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "sendTo": "={{ $('Config').first().json.admin_email }}",
        "subject": "={{ 'Outlier Desk weekly: ' + $('Read Week').first().json.unlocks + ' unlocks, $' + (Number($('Read Week').first().json.revenue_cents) / 100).toFixed(2) + ' revenue' }}",
        "message": "={{ (() => { const m = (c) => '$' + (Number(c || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); const d = $('Read Week').first().json; const L = {\"week_start\": \"Week starting\", \"new_creators\": \"New creators\", \"new_researchers\": \"New researchers\", \"researchers_verified\": \"Researchers verified\", \"briefs_live\": \"Briefs live\", \"private_briefs\": \"Private briefs\", \"pitches\": \"Pitches\", \"unlocks\": \"Unlocks\", \"unlock_rate_pct\": \"Unlock rate %\", \"gmv_cents\": \"GMV ($)\", \"revenue_cents\": \"Revenue ($)\", \"paid_out_cents\": \"Paid out ($)\", \"disputes\": \"Disputes\", \"flags\": \"Flags\"}; const rows = [\"new_creators\", \"new_researchers\", \"researchers_verified\", \"briefs_live\", \"private_briefs\", \"pitches\", \"unlocks\", \"unlock_rate_pct\", \"gmv_cents\", \"revenue_cents\", \"paid_out_cents\", \"disputes\", \"flags\"].map(k => `<tr><td style=\"padding:4px 16px 4px 0\">${L[k].replace(' ($)', '').replace(' %', '')}</td><td style=\"text-align:right;font-weight:600\">${k.endsWith('_cents') ? m(d[k]) : (d[k] ?? '–') + (k === 'unlock_rate_pct' && d[k] != null ? '%' : '')}</td></tr>`).join(''); return `<div style=\"font-family:system-ui,sans-serif;max-width:520px\"><h2 style=\"margin:0 0 12px\">Outlier Desk · week of ${d.week_start}</h2><table>${rows}</table></div>`; })() }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "725c8d22-db47-49cd-a6d8-f6bfe1a4b3d1",
      "name": "Email Report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "executeOnce": true
    },
    {
      "parameters": {
        "content": "## Weekly report · Mondays 8:30 Manila\nLast 7 days (sign-ups, verifications, briefs, private briefs, pitches, unlocks, unlock rate, GMV, revenue, payouts, disputes, flags) → a new row in your Google Sheet + an email.\n\n**Setup:** Google Sheets credential; a tab named **Weekly** with the column headers from *Add to Sheet*.",
        "height": 280,
        "width": 560,
        "color": 4
      },
