# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts payout account numbers. Any long random string; never change it after launch.
# Generate: openssl rand -base64 48
PAYOUT_ENCRYPTION_KEY=

# ---------- Payments ----------
# mock = test checkout inside the app (no real money). xendit = real payments.
PAYMENT_PROVIDER=mock
# Test mode on a production build (hosted closed beta only). Never set this once real payments are live.
ALLOW_TEST_PAYMENTS=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---------- Scheduled job (closes briefs, releases holds, sends refunds) ----------
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---------- Email (optional; without it emails are printed to the server log) ----------
RESEND_API_KEY=
EMAIL_FROM="Outlier Desk <hello@yourdomain.com>"

# ---------- Admin ----------
# Emails that get an "Continue as admin" option on first sign-in (comma separated).
ADMIN_EMAILS=

# Error monitoring (optional). Create a Next.js project at sentry.io and paste its DSN in both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Share of requests to trace for performance (0 to 1). Keep 0 on the free plan.
SENTRY_TRACES_SAMPLE_RATE=0

# Website chat assistant (n8n workflow 07). The chat bubble appears on public pages only when both are set.
# N8N_CHAT_WEBHOOK_URL is the workflow's production webhook URL; N8N_CHAT_SECRET must match its Header Auth credential.
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_SECRET=
