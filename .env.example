# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts payout account numbers. Any long random string; never change it after launch.
# Generate: openssl rand -base64 48
PAYOUT_ENCRYPTION_KEY=

# ---------- Payments ----------
# mock = test checkout inside the app (no real money). xendit = real payments.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_TOKEN=dev-mock-token
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---------- Scheduled job (closes briefs, releases holds, sends refunds) ----------
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---------- Email (optional; without it emails are printed to the server log) ----------
RESEND_API_KEY=
EMAIL_FROM="Outlier Desk <hello@yourdomain.com>"

# ---------- YouTube views check (optional) ----------
# A YouTube Data API v3 key (Google Cloud console, free quota). When set, YouTube source links in new
# pitches are checked: views and post date must match what the researcher claimed. Mismatches open a flag.
YOUTUBE_API_KEY=

# ---------- Admin ----------
# Emails that get an "Continue as admin" option on first sign-in (comma separated).
ADMIN_EMAILS=
# Admins must log in with an authenticator app. This is enforced in the database too; to switch it off on a
# LOCAL test database only, run in SQL:  update platform_settings set admin_mfa_required = false;
